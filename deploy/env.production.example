# Server environment for docker-compose.prod.yml. Lives only on the server as
# /opt/sanchara/.env (mode 600); never commit the real file.

# Set by the deploy (deploy/remote-deploy.sh) to the commit being released.
IMAGE_TAG=

# --- Hostnames (nginx serves these; see deploy/nginx/sanchara.conf) ---
PLATFORM_DOMAIN=sanchara.srv1187898.hstgr.cloud
BACKOFFICE_HOST=backoffice.sanchara.srv1187898.hstgr.cloud
ADMIN_HOST=admin.sanchara.srv1187898.hstgr.cloud
WEB_PORT=3100

# --- PostgreSQL ---
POSTGRES_USER=sanchara
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sanchara

# --- Google sign-in (not set up; the API only requires values) ---
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured
