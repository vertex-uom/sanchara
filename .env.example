# Sanchara - local development environment.
# Copy to .env and adjust. Placeholders only; never commit real credentials.

# --- Host ports (all bound to 127.0.0.1) ---
API_PORT=3000                # NestJS API
API_DEBUG_PORT=9229          # Node inspector for the API
WEB_PORT=3001                # Next.js dev server
POSTGRES_HOST_PORT=5434      # 5432 is often taken by a local Postgres
REDIS_HOST_PORT=6379

# --- PostgreSQL ---
# DATABASE_URL for the api container is built from these in docker-compose.yml.
POSTGRES_USER=sanchara
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sanchara_dev

# --- Redis ---
# REDIS_URL for the api container is set in docker-compose.yml (redis://redis:6379).

# --- App URLs ---
NEXT_PUBLIC_API_URL=http://localhost:3000   # API URL used by the browser
API_INTERNAL_URL=http://api:3000            # API URL used by Next.js server-side
WEB_APP_URL=http://localhost:3001           # Used by the API for redirects/links
BACKOFFICE_URL=http://backoffice.localhost:3001  # Used by the API for staff email links

# --- Auth ---
# Sessions are opaque ids in Redis; no signing secret needed.
# Company sites live on {company}.PLATFORM_DOMAIN.
PLATFORM_DOMAIN=sanchara.localhost
# Proxies whose X-Forwarded-For the API trusts. "uniquelocal" = the web container
# on the Docker network, which forwards the visitor's IP for rate limits.
TRUST_PROXY=uniquelocal
# Reverse proxies in front of Next that append the visitor's IP to
# X-Forwarded-For (e.g. 1 for one nginx/load balancer). Next forwards the entry
# that many places from the right; with 0 it forwards none, because without a
# proxy the header is whatever the browser sent. Production must set this.
TRUSTED_PROXY_HOPS=0

# --- Google OAuth (test client) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Next.js route (BFF) that Google redirects back to.
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# Back Office route Google redirects staff back to (register it on the client too).
GOOGLE_STAFF_CALLBACK_URL=http://backoffice.localhost:3001/sign-in/google/callback
# Admin console route Google redirects admins back to (register it on the client too).
GOOGLE_ADMIN_CALLBACK_URL=http://admin.localhost:3001/sign-in/google/callback

# --- PayHere (LKR), sandbox ---
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=your-sandbox-merchant-id
PAYHERE_MERCHANT_SECRET=your-sandbox-merchant-secret
PAYHERE_CURRENCY=LKR
PAYHERE_RETURN_URL=http://localhost:3001/payments/return
PAYHERE_CANCEL_URL=http://localhost:3001/payments/cancel
PAYHERE_NOTIFY_URL=http://localhost:3000/payments/payhere/notify

# --- USD card gateway (provider not decided yet) ---
CARD_GATEWAY_PROVIDER=
CARD_GATEWAY_MODE=sandbox
CARD_GATEWAY_CURRENCY=USD
CARD_GATEWAY_PUBLIC_KEY=your-sandbox-public-key
CARD_GATEWAY_SECRET_KEY=your-sandbox-secret-key
CARD_GATEWAY_WEBHOOK_SECRET=your-sandbox-webhook-secret

# --- WhatsApp Business API (test number) ---
WHATSAPP_API_BASE_URL=https://example.invalid/whatsapp
WHATSAPP_PHONE_NUMBER_ID=your-test-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-test-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-random-dev-string

# --- Email (SMTP; point at a sandbox/catch-all inbox) ---
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM="Sanchara Dev <no-reply@example.invalid>"

# --- Dev tooling ---
WATCHPACK_POLLING=false      # Set true if web hot reload misses changes (Docker Desktop/WSL)
