generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Ids are UUIDv7 (time-ordered, so B-tree inserts stay local) in native uuid columns.
// CHECK constraints the schema can't express live in the migration SQL.

enum GuestStatus {
  ACTIVE
  DISABLED

  @@map("guest_status")
}

enum IdentityProvider {
  GOOGLE

  @@map("identity_provider")
}

model Guest {
  id              String      @id @default(uuid(7)) @db.Uuid
  fullName        String      @map("full_name") @db.VarChar(120)
  // Stored trimmed and lowercased; the unique index is the lookup index.
  email           String      @unique @db.VarChar(254)
  // E.164, e.g. +94771234567.
  mobile          String?     @db.VarChar(16)
  status          GuestStatus @default(ACTIVE)
  emailVerifiedAt DateTime?   @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordCredential PasswordCredential?
  externalIdentities ExternalIdentity[]

  @@map("guests")
}

// One per guest; the guest id is the primary key, so no extra index.
model PasswordCredential {
  guestId   String   @id @map("guest_id") @db.Uuid
  // argon2id encoded string (params + salt + hash). Never the password.
  hash      String
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model ExternalIdentity {
  id        String           @id @default(uuid(7)) @db.Uuid
  guestId   String           @map("guest_id") @db.Uuid
  provider  IdentityProvider
  // The provider's stable user id (Google "sub").
  subject   String           @db.VarChar(255)
  // Email the provider reported when the identity was linked.
  email     String           @db.VarChar(254)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([guestId])
  @@map("external_identities")
}

// --- Companies (tenants) ---

enum CompanyStatus {
  // Created by the platform team; the Owner has not accepted the invite yet.
  PENDING_SETUP
  ACTIVE
  SUSPENDED_NON_PAYMENT
  SUSPENDED_BY_ADMIN

  @@map("company_status")
}

model Company {
  id             String        @id @default(uuid(7)) @db.Uuid
  name           String        @db.VarChar(120)
  // The site lives on {subdomain}.PLATFORM_DOMAIN. Lowercase DNS label.
  subdomain      String        @unique @db.VarChar(63)
  // Current status; every change is also recorded in company_status_changes.
  status         CompanyStatus @default(ACTIVE)
  legalName      String?       @map("legal_name") @db.VarChar(160)
  // Business registration number, when registered.
  registrationNo String?       @map("registration_no") @db.VarChar(40)
  // Town or area the business is based in. Required by platform onboarding;
  // null for companies created before it existed.
  town           String?       @db.VarChar(80)
  // The platform admin who created the company; null when not created by one.
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy                 PlatformAdmin?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  staff                     Staff[]
  statusChanges             CompanyStatusChange[]
  properties                Property[]
  subscriptions             Subscription[]
  websiteAssistanceRequests WebsiteAssistanceRequest[]

  @@index([status])
  @@index([createdById])
  @@map("companies")
}

// Append-only history of company status changes (the state machine's trail).
model CompanyStatusChange {
  id          String         @id @default(uuid(7)) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  // Null on the first entry, when the company was created.
  fromStatus  CompanyStatus? @map("from_status")
  toStatus    CompanyStatus  @map("to_status")
  reason      String?        @db.VarChar(500)
  // The admin who made the change; null when the system or the Owner did.
  changedById String?        @map("changed_by_id") @db.Uuid
  changedAt   DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  changedBy PlatformAdmin? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([companyId, changedAt])
  @@index([changedById])
  @@map("company_status_changes")
}

// --- Staff (Back Office users) ---

enum StaffRole {
  OWNER
  MANAGER
  FRONT_DESK

  @@map("staff_role")
}

// INVITED until the invite is accepted; INACTIVE when deactivated.
enum StaffStatus {
  INVITED
  ACTIVE
  INACTIVE

  @@map("staff_status")
}

model Staff {
  id          String      @id @default(uuid(7)) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  fullName    String      @map("full_name") @db.VarChar(120)
  // Stored trimmed and lowercased. Unique across the platform, so sign-in on the
  // one Back Office host finds exactly one account.
  email       String      @unique @db.VarChar(254)
  role        StaffRole
  status      StaffStatus @default(INVITED)
  // E.164, e.g. +94771234567.
  phone       String?     @db.VarChar(16)
  // When the invite was accepted (proves the email).
  activatedAt DateTime?   @map("activated_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  passwordCredential        StaffPasswordCredential?
  externalIdentities        StaffExternalIdentity[]
  websiteAssistanceRequests WebsiteAssistanceRequest[]

  // Plus a partial unique index in the migration: one OWNER per company.
  @@index([companyId])
  @@map("staff")
}

// One per staff account; the staff id is the primary key, so no extra index.
model StaffPasswordCredential {
  staffId   String   @id @map("staff_id") @db.Uuid
  // argon2id encoded string (params + salt + hash). Never the password.
  hash      String
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_password_credentials")
}

model StaffExternalIdentity {
  id        String           @id @default(uuid(7)) @db.Uuid
  staffId   String           @map("staff_id") @db.Uuid
  provider  IdentityProvider
  // The provider's stable user id (Google "sub").
  subject   String           @db.VarChar(255)
  // Email the provider reported when the identity was linked.
  email     String           @db.VarChar(254)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([staffId])
  @@map("staff_external_identities")
}

// --- Reference data (seeded by migrations; changed only by migrations) ---

// Sri Lanka's 9 provinces and 25 districts. A property stores only its
// district; the province follows from it, so it is never stored twice.
model Province {
  id        Int        @id @db.SmallInt
  name      String     @unique @db.VarChar(40)
  districts District[]

  @@map("provinces")
}

model District {
  id         Int        @id @db.SmallInt
  provinceId Int        @map("province_id") @db.SmallInt
  name       String     @unique @db.VarChar(40)
  province   Province   @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  properties Property[]

  @@index([provinceId])
  @@map("districts")
}

model PropertyType {
  id         Int        @id @db.SmallInt
  // Stable key clients send, e.g. GUEST_HOUSE. The name is display text.
  code       String     @unique @db.VarChar(32)
  name       String     @unique @db.VarChar(60)
  sortOrder  Int        @map("sort_order") @db.SmallInt
  // Retired types stay for existing properties but can't be chosen.
  isActive   Boolean    @default(true) @map("is_active")
  properties Property[]

  @@map("property_types")
}

// Subscription plans. Prices are in minor units (cents) of `currency`.
model Plan {
  id                Int            @id @db.SmallInt
  code              String         @unique @db.VarChar(32)
  name              String         @unique @db.VarChar(60)
  monthlyPriceMinor Int            @map("monthly_price_minor")
  // ISO 4217, e.g. LKR.
  currency          String         @db.Char(3)
  sortOrder         Int            @map("sort_order") @db.SmallInt
  isActive          Boolean        @default(true) @map("is_active")
  subscriptions     Subscription[]

  @@map("plans")
}

// --- Platform admins (the platform team) ---

enum AdminStatus {
  ACTIVE
  DISABLED

  @@map("admin_status")
}

model PlatformAdmin {
  id           String      @id @default(uuid(7)) @db.Uuid
  fullName     String      @map("full_name") @db.VarChar(120)
  // Stored trimmed and lowercased.
  email        String      @unique @db.VarChar(254)
  status       AdminStatus @default(ACTIVE)
  lastSignInAt DateTime?   @map("last_sign_in_at") @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordCredential      AdminPasswordCredential?
  externalIdentities      AdminExternalIdentity[]
  companiesCreated        Company[]
  statusChanges           CompanyStatusChange[]
  announcementsCreated    Announcement[]             @relation("AnnouncementCreatedBy")
  announcementsArchived   Announcement[]             @relation("AnnouncementArchivedBy")
  websiteRequestsAssigned WebsiteAssistanceRequest[]
  websiteRequestNotes     WebsiteAssistanceNote[]

  @@map("platform_admins")
}

// One per admin; the admin id is the primary key, so no extra index.
// Google accounts linked to an admin. Google only signs in existing admins; the
// first sign-in links the account when its verified email matches.
model AdminExternalIdentity {
  id        String           @id @default(uuid(7)) @db.Uuid
  adminId   String           @map("admin_id") @db.Uuid
  provider  IdentityProvider
  // The provider's stable user id (Google "sub").
  subject   String           @db.VarChar(255)
  // Email the provider reported when the identity was linked.
  email     String           @db.VarChar(254)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([adminId])
  @@map("admin_external_identities")
}

model AdminPasswordCredential {
  adminId   String   @id @map("admin_id") @db.Uuid
  // argon2id encoded string (params + salt + hash). Never the password.
  hash      String
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_password_credentials")
}

// --- Properties ---

// "Inactive" hides the property from the website and booking channels.
enum PropertyStatus {
  ACTIVE
  INACTIVE
}

enum PropertyCategory {
  BEACHFRONT
  CITY
  HILL_COUNTRY
  WILDLIFE
  LAKESIDE
  HERITAGE
  RURAL
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
  NON_REFUNDABLE
}

enum SmokingPolicy {
  NOT_ALLOWED
  DESIGNATED_AREAS
  ALLOWED
}

// Settings are edited by the company's Owner only (Property Settings).
model Property {
  id                 String             @id @default(uuid(7)) @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  propertyTypeId     Int                @map("property_type_id") @db.SmallInt
  name               String             @db.VarChar(120)
  // URL key on the central directory (/properties/{slug}); unique platform-wide.
  // Set once from the first name; renaming the property keeps it.
  slug               String             @unique @db.VarChar(80)
  status             PropertyStatus     @default(ACTIVE)
  description        String             @default("") @db.VarChar(250)
  starRating         Int?               @map("star_rating") @db.SmallInt
  establishedYear    Int?               @map("established_year") @db.SmallInt
  category           PropertyCategory?
  // Contact. Phone and email are required on save but null until the Owner sets them.
  phone              String?            @db.VarChar(20)
  email              String?            @db.VarChar(254)
  whatsapp           String?            @db.VarChar(20)
  websiteUrl         String?            @map("website_url") @db.VarChar(500)
  mapUrl             String?            @map("map_url") @db.VarChar(500)
  addressLine1       String             @map("address_line1") @db.VarChar(160)
  addressLine2       String?            @map("address_line2") @db.VarChar(160)
  city               String             @db.VarChar(80)
  districtId         Int                @map("district_id") @db.SmallInt
  // Sri Lankan postal codes are 5 digits.
  postalCode         String?            @map("postal_code") @db.Char(5)
  // Policies. Times are "HH:MM", Sri Lanka time.
  checkInFrom        String             @default("14:00") @map("check_in_from") @db.Char(5)
  checkInUntil       String?            @map("check_in_until") @db.Char(5)
  checkOutBy         String             @default("11:00") @map("check_out_by") @db.Char(5)
  cancellationPolicy CancellationPolicy @default(MODERATE) @map("cancellation_policy")
  childrenAllowed    Boolean            @default(true) @map("children_allowed")
  petsAllowed        Boolean            @default(false) @map("pets_allowed")
  smokingPolicy      SmokingPolicy      @default(NOT_ALLOWED) @map("smoking_policy")
  houseRules         String             @default("") @map("house_rules") @db.VarChar(1000)
  // Keys from the fixed list in properties.policy.ts.
  amenities          String[]           @default([]) @db.VarChar(40)
  // Integrations.
  googleAnalyticsId  String?            @map("google_analytics_id") @db.VarChar(20)
  metaPixelId        String?            @map("meta_pixel_id") @db.VarChar(20)
  googleBusinessUrl  String?            @map("google_business_url") @db.VarChar(500)
  tripAdvisorUrl     String?            @map("trip_advisor_url") @db.VarChar(500)
  bookingComIcalUrl  String?            @map("booking_com_ical_url") @db.VarChar(500)
  airbnbIcalUrl      String?            @map("airbnb_ical_url") @db.VarChar(500)
  // Advanced.
  sltdaNumber        String?            @map("sltda_number") @db.VarChar(30)
  vatNumber          String?            @map("vat_number") @db.VarChar(14)
  invoicePrefix      String             @default("INV") @map("invoice_prefix") @db.VarChar(6)
  bookingWindowDays  Int                @default(365) @map("booking_window_days") @db.SmallInt
  minNoticeHours     Int                @default(0) @map("min_notice_hours") @db.SmallInt
  // Bumped on every settings save; a save made from an older version is refused.
  settingsVersion    Int                @default(1) @map("settings_version")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  propertyType              PropertyType               @relation(fields: [propertyTypeId], references: [id], onDelete: Restrict)
  district                  District                   @relation(fields: [districtId], references: [id], onDelete: Restrict)
  websiteAssistanceRequests WebsiteAssistanceRequest[]

  @@index([companyId])
  @@index([propertyTypeId])
  @@index([districtId])
  @@map("properties")
}

// --- Subscriptions: which plan a company is on. Billing rules are open;
// this records the choice and its lifecycle only. ---

enum SubscriptionStatus {
  // Chosen at creation; no payment yet.
  PENDING
  ACTIVE
  CANCELLED

  @@map("subscription_status")
}

model Subscription {
  id        String             @id @default(uuid(7)) @db.Uuid
  companyId String             @map("company_id") @db.Uuid
  planId    Int                @map("plan_id") @db.SmallInt
  status    SubscriptionStatus @default(PENDING)
  startedAt DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  // Set when the subscription is replaced or cancelled; null = current.
  endedAt   DateTime?          @map("ended_at") @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  // Plus a partial unique index in the migration: one current subscription per company.
  @@index([companyId])
  @@index([planId])
  @@map("subscriptions")
}

// --- Audit log: who changed what, when. Append-only. No foreign keys on
// purpose: entries outlive the rows they describe (kept for 1 year). ---

enum AuditActorType {
  PLATFORM_ADMIN
  STAFF
  GUEST
  SYSTEM

  @@map("audit_actor_type")
}

model AuditEntry {
  id         String         @id @default(uuid(7)) @db.Uuid
  occurredAt DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType  AuditActorType @map("actor_type")
  // Null only for SYSTEM.
  actorId    String?        @map("actor_id") @db.Uuid
  // The tenant the change belongs to; null for platform-wide changes.
  companyId  String?        @map("company_id") @db.Uuid
  // Dotted verb, e.g. "company.created".
  action     String         @db.VarChar(64)
  entityType String         @map("entity_type") @db.VarChar(40)
  entityId   String         @map("entity_id") @db.Uuid
  // Non-secret details of the change.
  details    Json?          @db.JsonB

  @@index([companyId, occurredAt])
  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@map("audit_entries")
}

// --- Announcements ---------------------------------------------------------
// Platform-wide notices from the platform team to company staff, delivered as
// system notifications (never email or WhatsApp). Status is derived from the
// times: scheduled before starts_at, active until ends_at, archived after it or
// once archived_at is set. published_at / withdrawn_at record when the
// announcement.published / announcement.withdrawn events were raised.

enum AnnouncementType {
  FEATURE
  MAINTENANCE
  POLICY
  REMINDER
  URGENT

  @@map("announcement_type")
}

// Staff roles that receive it, in active and suspended companies.
enum AnnouncementAudience {
  ALL_STAFF
  OWNERS
  MANAGERS
  FRONT_DESK

  @@map("announcement_audience")
}

model Announcement {
  id           String               @id @default(uuid(7)) @db.Uuid
  // Plain text; clients render it as text, never as HTML.
  title        String               @db.VarChar(80)
  message      String               @db.VarChar(400)
  type         AnnouncementType
  audience     AnnouncementAudience
  // Staff may close the notification.
  dismissible  Boolean              @default(true)
  startsAt     DateTime             @map("starts_at") @db.Timestamptz(3)
  // Null: stays until archived.
  endsAt       DateTime?            @map("ends_at") @db.Timestamptz(3)
  createdById  String?              @map("created_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Set when an admin archived it (or cancelled it before it started).
  archivedAt   DateTime?            @map("archived_at") @db.Timestamptz(3)
  archivedById String?              @map("archived_by_id") @db.Uuid
  publishedAt  DateTime?            @map("published_at") @db.Timestamptz(3)
  withdrawnAt  DateTime?            @map("withdrawn_at") @db.Timestamptz(3)

  createdBy  PlatformAdmin? @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedBy PlatformAdmin? @relation("AnnouncementArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  // The publisher's queues are partial indexes in the migration SQL.
  @@index([startsAt])
  @@map("announcements")
}

// --- Website assistance ----------------------------------------------------
// A company's request for WEMIXT (the platform team) to build its website,
// sent from the Back Office by the Owner or a Manager, and the team's work on
// it. One open request per company (partial unique index in the migration).
// Its timeline (sent, changed, assigned, status changes) is the audit log.

enum WebsiteAssistanceStatus {
  REQUESTED
  IN_PROGRESS
  REVIEW
  PUBLISHED
  CANCELLED

  @@map("website_assistance_status")
}

enum WebsiteAssistanceStyle {
  COASTAL
  MODERN
  LUXURY
  COZY

  @@map("website_assistance_style")
}

enum WebsiteAssistanceTiming {
  ONE_WEEK
  TWO_WEEKS
  ONE_MONTH
  NO_RUSH

  @@map("website_assistance_timing")
}

enum WebsiteAssistanceContact {
  WHATSAPP
  PHONE
  EMAIL

  @@map("website_assistance_contact")
}

model WebsiteAssistanceRequest {
  id            String                   @id @default(uuid(7)) @db.Uuid
  // "WMX-20481": what the Owner and the team quote.
  reference     String                   @unique @db.VarChar(12)
  companyId     String                   @map("company_id") @db.Uuid
  // The property the request was sent for.
  propertyId    String?                  @map("property_id") @db.Uuid
  requestedById String?                  @map("requested_by_id") @db.Uuid
  status        WebsiteAssistanceStatus  @default(REQUESTED)
  contactName   String                   @map("contact_name") @db.VarChar(80)
  phone         String                   @db.VarChar(20)
  email         String                   @db.VarChar(254)
  contactMethod WebsiteAssistanceContact @map("contact_method")
  // Keys from website-assistance.policy.ts.
  goals         String[]                 @default([]) @db.VarChar(40)
  style         WebsiteAssistanceStyle
  timing        WebsiteAssistanceTiming
  notes         String                   @default("") @db.VarChar(600)
  // When the team aims to finish, from the timing; null for "no rush".
  dueAt         DateTime?                @map("due_at") @db.Timestamptz(3)
  assigneeId    String?                  @map("assignee_id") @db.Uuid
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Set when it is published or cancelled.
  closedAt      DateTime?                @map("closed_at") @db.Timestamptz(3)

  company       Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  property      Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  requestedBy   Staff?                  @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  assignee      PlatformAdmin?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  internalNotes WebsiteAssistanceNote[]

  @@index([companyId])
  @@index([status, dueAt])
  @@index([assigneeId])
  @@map("website_assistance_requests")
}

// The platform team's notes on a request. The company never sees them.
model WebsiteAssistanceNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  text      String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request WebsiteAssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  PlatformAdmin?           @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("website_assistance_notes")
}
