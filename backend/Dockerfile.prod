# syntax=docker/dockerfile:1
# Production image, built by GitHub Actions (.github/workflows/deploy.yml) and
# run by docker-compose.prod.yml. The development image is ./Dockerfile.
FROM node:22.23.3-bookworm-slim AS base
# openssl: Prisma schema engine (prisma migrate deploy).
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS build
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# prisma generate reads prisma.config.ts, which needs a DATABASE_URL; it never connects.
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build node_modules/.bin/prisma generate \
 && node_modules/.bin/nest build

FROM base AS runtime
ENV NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false
COPY package.json package-lock.json ./
# Runtime dependencies plus the Prisma CLI (a devDependency) at the locked
# version, so the container can apply migrations before it starts.
RUN npm ci --omit=dev --no-audit --no-fund \
 && npm install --no-save --no-audit --no-fund \
      "prisma@$(node -p "require('./package-lock.json').packages['node_modules/prisma'].version")" \
 && find node_modules -maxdepth 2 -type d \( -name '*-musl' -o -name '*linuxmusl*' \) -prune -exec rm -rf {} + \
 && npm cache clean --force
COPY prisma.config.ts ./
COPY prisma ./prisma
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3000
CMD ["sh", "-c", "node_modules/.bin/prisma migrate deploy && exec node dist/main"]
